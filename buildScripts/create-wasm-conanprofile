#!/usr/bin/env bash

set -euo pipefail

mkdir -p build/wasm

# The Emscripten CMake toolchain file teaches CMake about the Emscripten
# platform (e.g. byte order, type sizes). Without it, dependency builds that
# call TEST_BIG_ENDIAN fall back to a broken detection path and fail to
# configure. Conan generates its own toolchain, so we chain-load Emscripten's
# via tools.cmake.cmaketoolchain:user_toolchain. em-config also finds it for
# Homebrew, where emcc on PATH is a symlink.
EMSCRIPTEN_TOOLCHAIN="$(em-config EMSCRIPTEN_ROOT)/cmake/Modules/Platform/Emscripten.cmake"
if [ ! -f "${EMSCRIPTEN_TOOLCHAIN}" ]; then
   echo "Could not find Emscripten CMake toolchain at ${EMSCRIPTEN_TOOLCHAIN}" >&2
   exit 1
fi

# Every object in the module (dependencies and RhyDB) needs the same flags:
# -pthread     wasm atomics and shared memory; the linker rejects objects without it
# -fexceptions exceptions unwind through all frames, including dependencies
cat > build/wasm/conanprofile-emscripten <<PROFILE
[settings]
os=Emscripten
arch=wasm
compiler=emcc
compiler.version=$(emcc -dumpversion)
compiler.libcxx=libc++
compiler.cppstd=23
build_type=Release

[conf]
tools.build:compiler_executables={"c":"emcc","cpp":"em++"}
tools.build:cflags=["-pthread"]
tools.build:cxxflags=["-pthread","-fexceptions"]
tools.build:exelinkflags=["-pthread","-fexceptions"]
tools.build:sharedlinkflags=["-pthread","-fexceptions"]
tools.cmake.cmaketoolchain:generator=Ninja
tools.cmake.cmaketoolchain:user_toolchain=["${EMSCRIPTEN_TOOLCHAIN}"]
PROFILE
