#!/bin/bash
set -meuo pipefail
IFS=

cd ..

set -x

case "$BUILD" in
    Release)
        make build/Release/rhydb
        ;;
    Debug)
        make build/Debug/rhydb
        ;;
    *)
        echo "invalid BUILD value '$BUILD'"
        exit 1
esac

# `ln` works, too, currently (the SILO build does not overwrite the
# original file in place), but it's dicey, so better use 'cp'
cp build/"$BUILD"/rhydb{,_"$COMMIT_ID"}
