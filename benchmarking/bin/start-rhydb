#!/bin/bash
set -meuo pipefail
IFS=

# Start and wait until up

bin/run-rhydb > "$BENCH_OUTPUT_LOG" &
disown %

echo "Waiting for pid file..."
n=0
until [ -e .rhydb.pid ]; do
    n=$(( n + 1 ))
    if (( n > 180 )); then
        echo "Timing out waiting for RhyDB to come up. Output so far:"
        cat "$BENCH_OUTPUT_LOG"
        exit 1
    fi
    sleep 1
done
echo "done."

pid=$(cat .rhydb.pid)

n=0
until kill -0 "$pid"; do
    n=$(( n + 1 ))
    if (( n > 20 )); then
        echo "RhyDB is not there. Output:"
        cat "$BENCH_OUTPUT_LOG"
        exit 1
    fi
    pid=$(cat .rhydb.pid)
    sleep 0.5
done

echo "Waiting for rhydb (PID $pid) to be ready..."
until curl -s -o /dev/null -w "%{http_code}" http://localhost:8081/info | grep -q "200"; do 
    sleep 0.5
done
echo "done."
